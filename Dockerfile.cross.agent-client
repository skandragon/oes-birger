#
# Copy-only multi-arch assembly. Compiles NOTHING per-arch: the binary is
# cross-built on the amd64 worker (.woodpecker/build.yaml) and staged into
# docker/bin/linux_${TARGETARCH}/, so the only emulated arm64 work is the tiny
# apk layer. Context is trimmed to docker/ by the matching .dockerignore.

FROM alpine:3
ARG TARGETARCH

RUN apk update && apk upgrade --no-cache && apk add --no-cache ca-certificates curl
RUN update-ca-certificates ; exit 0
RUN mkdir /local /local/ca-certificates && rm -rf /usr/local/share/ca-certificates && ln -s /local/ca-certificates /usr/local/share/ca-certificates

WORKDIR /app
COPY docker/run.sh /app/run.sh
COPY docker/bin/linux_${TARGETARCH}/agent-client /app/agent-client

EXPOSE 9102

ENTRYPOINT ["/bin/sh", "/app/run.sh"]
CMD ["/app/agent-client"]
